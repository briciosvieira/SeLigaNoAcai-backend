// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  GUEST
  MANUAL
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum AdminPermission {
  MANAGE_DASHBOARD
  MANAGE_ORDERS
  MANAGE_PRODUCTS
  MANAGE_PAYMENTS
  MANAGE_CUSTOMERS
  MANAGE_LOYALTY
  MANAGE_STORE
  MANAGE_DELIVERY_ZONES
  MANAGE_UPLOADS
  MANAGE_USERS
}

enum ProductType {
  SIMPLE
  CUSTOM
  COMBO
}

enum SelectionType {
  SINGLE
  MULTIPLE
}

enum PaymentMethod {
  PIX
  CREDIT_ONLINE
  CARD_ON_DELIVERY
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum OrderStatus {
  CREATED
  AWAITING_PAYMENT
  PAID
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum OrderSource {
  SITE
  WHATSAPP
  IFOOD
  ADMIN
}

enum LoyaltyCardStatus {
  ACTIVE
  COMPLETED
  REWARD_AVAILABLE
  REDEEMED
  EXPIRED
  CANCELED
}

enum LoyaltyTransactionType {
  STAMP_EARNED
  REWARD_AVAILABLE
  REWARD_REDEEMED
  CARD_EXPIRED
  ADJUSTMENT
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Store {
  id String @id @default(uuid())

  name String @db.VarChar(120)
  slug String @unique @db.VarChar(120)

  logoUrl        String? @map("logo_url")
  whatsappNumber String? @map("whatsapp_number") @db.VarChar(30)
  ifoodUrl       String? @map("ifood_url")

  pixKey     String? @map("pix_key") @db.VarChar(180)
  pixKeyType String? @map("pix_key_type") @db.VarChar(40)

  rating             Decimal? @db.Decimal(3, 2)
  minDeliveryMinutes Int?     @map("min_delivery_minutes")
  maxDeliveryMinutes Int?     @map("max_delivery_minutes")

  minimumOrderAmount Decimal @default(0) @map("minimum_order_amount") @db.Decimal(10, 2)

  isActive Boolean @default(true) @map("is_active")

  isOpen                Boolean   @default(false) @map("is_open") // Status atual da loja
  scheduledIsOpen       Boolean?  @map("scheduled_is_open") // Status futuro agendado
  availabilityChangeAt  DateTime? @map("availability_change_at") // Horário em que a mudança de status ocorrerá
  availabilityUpdatedAt DateTime? @map("availability_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveryZones   DeliveryZone[]
  categories      Category[]
  products        Product[]
  optionGroups    OptionGroup[]
  orders          Order[]
  loyaltyPrograms LoyaltyProgram[]

  @@map("stores")
}

model DeliveryZone {
  id String @id @default(uuid())

  storeId String @map("store_id")
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  neighborhood String @db.VarChar(120)
  city         String @default("Salvador") @db.VarChar(120)
  state        String @default("BA") @db.VarChar(2)

  deliveryFee Decimal @default(0) @map("delivery_fee") @db.Decimal(10, 2)

  isAvailable  Boolean @default(true) @map("is_available")
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  addresses CustomerAddress[]
  orders    Order[]

  @@unique([storeId, neighborhood, city, state])
  @@map("delivery_zones")
}

model Customer {
  id String @id @default(uuid())

  customerCode String? @unique @map("customer_code") @db.VarChar(7)

  fullName        String? @map("full_name") @db.VarChar(160)
  email           String? @unique
  phone           String? @db.VarChar(30)
  cpf             String? @unique @db.VarChar(20)
  avatarUrl       String? @map("avatar_url")
  googleAvatarUrl String? @map("google_avatar_url")

  termsAcceptedAt   DateTime? @map("terms_accepted_at")
  privacyAcceptedAt DateTime? @map("privacy_accepted_at")
  termsVersion      String?   @map("terms_version") @db.VarChar(20)
  privacyVersion    String?   @map("privacy_version") @db.VarChar(20)

  authProvider   AuthProvider @default(GUEST) @map("auth_provider")
  authProviderId String?      @map("auth_provider_id") @db.VarChar(180)

  role UserRole @default(CUSTOMER)

  adminPermissions CustomerAdminPermission[]

  passwordHash     String?   @map("password_hash")
  refreshTokenHash String?   @map("refresh_token_hash")
  lastLoginAt      DateTime? @map("last_login_at")

  isGuest            Boolean @default(true) @map("is_guest")
  isActive           Boolean @default(true) @map("is_active")
  mustChangePassword Boolean @default(false) @map("must_change_password")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  addresses        CustomerAddress[]
  orders           Order[]
  loyaltyCards     CustomerLoyaltyCard[]
  loyaltyCycleCards LoyaltyCard[]
  loyalty          CustomerLoyalty?
  notificationLogs NotificationLog[]

  @@unique([authProvider, authProviderId])
  @@map("customers")
}

model CustomerAdminPermission {
  id         String          @id @default(uuid())
  customerId String          @map("customer_id")
  permission AdminPermission
  createdAt  DateTime        @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, permission])
  @@index([customerId])
  @@index([permission])
  @@map("customer_admin_permissions")
}

model CustomerAddress {
  id String @id @default(uuid())

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  deliveryZoneId String?       @map("delivery_zone_id")
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)

  label          String? @db.VarChar(60)
  street         String? @db.VarChar(180)
  number         String? @db.VarChar(30)
  complement     String? @db.VarChar(120)
  referencePoint String? @map("reference_point") @db.VarChar(180)

  neighborhood String? @db.VarChar(120)
  city         String? @default("Salvador") @db.VarChar(120)
  state        String? @default("BA") @db.VarChar(2)

  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("customer_addresses")
}

model Category {
  id String @id @default(uuid())

  storeId String @map("store_id")
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)
  slug String @db.VarChar(100)

  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@unique([storeId, slug])
  @@map("categories")
}

model Product {
  id String @id @default(uuid())

  storeId String @map("store_id")
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name        String  @db.VarChar(140)
  slug        String  @db.VarChar(140)
  description String?

  emoji          String? @db.VarChar(20)
  imageUrl       String? @map("image_url")
  mobileImageUrl String? @map("mobile_image_url")

  basePrice Decimal  @default(0) @map("base_price") @db.Decimal(10, 2)
  oldPrice  Decimal? @map("old_price") @db.Decimal(10, 2)

  badge String? @db.VarChar(40)

  productType ProductType @default(SIMPLE) @map("product_type")

  isFeatured Boolean @default(false) @map("is_featured")
  isOffer    Boolean @default(false) @map("is_offer")
  isActive   Boolean @default(true) @map("is_active")

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variants            ProductVariant[]
  productOptionGroups ProductOptionGroup[]
  orderItems          OrderItem[]

  promotionsAsBuyProduct    Promotion[]                @relation("PromotionBuyProduct")
  promotionsAsRewardProduct Promotion[]                @relation("PromotionRewardProduct")
  promotionEligibleProducts PromotionEligibleProduct[]

  @@unique([storeId, slug])
  @@map("products")
}

model ProductVariant {
  id String @id @default(uuid())

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name  String  @db.VarChar(80)
  price Decimal @db.Decimal(10, 2)

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@unique([productId, name])
  @@map("product_variants")
}

model OptionGroup {
  id String @id @default(uuid())

  storeId String @map("store_id")
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)
  slug String @db.VarChar(100)

  selectionType SelectionType @map("selection_type")
  minSelected   Int           @default(0) @map("min_selected")
  maxSelected   Int?          @map("max_selected")

  isRequired Boolean @default(false) @map("is_required")
  isActive   Boolean @default(true) @map("is_active")

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  options             Option[]
  productOptionGroups ProductOptionGroup[]
  orderItemOptions    OrderItemOption[]

  @@unique([storeId, slug])
  @@map("option_groups")
}

model Option {
  id String @id @default(uuid())

  optionGroupId String      @map("option_group_id")
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(100)
  description String?
  emoji       String? @db.VarChar(20)

  additionalPrice Decimal @default(0) @map("additional_price") @db.Decimal(10, 2)

  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orderItemOptions OrderItemOption[]

  @@unique([optionGroupId, name])
  @@map("options")
}

model ProductOptionGroup {
  id String @id @default(uuid())

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  optionGroupId String      @map("option_group_id")
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  minSelected Int?     @map("min_selected")
  maxSelected Int?     @map("max_selected")
  isRequired  Boolean? @map("is_required")

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, optionGroupId])
  @@map("product_option_groups")
}

model Order {
  id String @id @default(uuid())

  storeId String @map("store_id")
  store   Store  @relation(fields: [storeId], references: [id])

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerAddressId String?          @map("customer_address_id")
  customerAddress   CustomerAddress? @relation(fields: [customerAddressId], references: [id], onDelete: SetNull)

  deliveryZoneId String?       @map("delivery_zone_id")
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)

  orderNumber String @unique @map("order_number") @db.VarChar(30)

  customerName  String? @map("customer_name") @db.VarChar(160)
  customerPhone String? @map("customer_phone") @db.VarChar(30)
  customerEmail String? @map("customer_email")

  deliveryNeighborhood String? @map("delivery_neighborhood") @db.VarChar(120)
  deliveryAddressText  String? @map("delivery_address_text")

  subtotalAmount Decimal @default(0) @map("subtotal_amount") @db.Decimal(10, 2)
  deliveryFee    Decimal @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal @default(0) @map("total_amount") @db.Decimal(10, 2)

  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")

  orderStatus OrderStatus @default(CREATED) @map("order_status")

  changeForAmount Decimal? @map("change_for_amount") @db.Decimal(10, 2)
  notes           String?

  whatsappMessage String?     @map("whatsapp_message")
  source          OrderSource @default(SITE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items                 OrderItem[]
  payments              Payment[]
  statusHistory         OrderStatusHistory[]
  loyaltyTransactions   LoyaltyTransaction[]
  loyaltyStampHistories LoyaltyStampHistory[]
  notifications         NotificationLog[]

  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productVariantId String?         @map("product_variant_id")
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  productName String  @map("product_name") @db.VarChar(140)
  variantName String? @map("variant_name") @db.VarChar(80)

  quantity Int @default(1)

  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  optionsAmount Decimal @default(0) @map("options_amount") @db.Decimal(10, 2)
  totalAmount   Decimal @map("total_amount") @db.Decimal(10, 2)

  itemDescription String? @map("item_description")

  createdAt DateTime @default(now()) @map("created_at")

  options OrderItemOption[]

  @@map("order_items")
}

model OrderItemOption {
  id String @id @default(uuid())

  orderItemId String    @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  optionGroupId String?      @map("option_group_id")
  optionGroup   OptionGroup? @relation(fields: [optionGroupId], references: [id], onDelete: SetNull)

  optionId String? @map("option_id")
  option   Option? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  groupName  String @map("group_name") @db.VarChar(100)
  optionName String @map("option_name") @db.VarChar(100)

  additionalPrice Decimal @default(0) @map("additional_price") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("order_item_options")
}

model Payment {
  id String @id @default(uuid())

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  paymentMethod PaymentMethod @map("payment_method")
  status        PaymentStatus @default(PENDING)

  amount Decimal @db.Decimal(10, 2)

  provider          String? @db.VarChar(60)
  providerPaymentId String? @map("provider_payment_id") @db.VarChar(180)

  pixQrCode    String?   @map("pix_qr_code")
  pixCopyPaste String?   @map("pix_copy_paste")
  pixExpiresAt DateTime? @map("pix_expires_at")

  installments   Int?
  cardBrand      String? @map("card_brand") @db.VarChar(40)
  cardLastDigits String? @map("card_last_digits") @db.VarChar(4)

  providerEndToEndId String?  @map("provider_end_to_end_id") @db.VarChar(80)
  payerName          String?  @map("payer_name") @db.VarChar(120)
  payerDocument      String?  @map("payer_document") @db.VarChar(20)
  payerBank          String?  @map("payer_bank") @db.VarChar(120)
  amountPaid         Decimal? @map("amount_paid") @db.Decimal(10, 2)
  webhookPayload     Json?    @map("webhook_payload")

  paidAt       DateTime? @map("paid_at")
  failedReason String?   @map("failed_reason")

  pixStatusCheckAttempts  Int       @default(0)  @map("pix_status_check_attempts")
  nextPixStatusCheckAt    DateTime? @map("next_pix_status_check_at")
  lastPixStatusCheckedAt  DateTime? @map("last_pix_status_checked_at")
  pixStatusCheckFinished  Boolean   @default(false) @map("pix_status_check_finished")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payments")
}

model OrderStatusHistory {
  id String @id @default(uuid())

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  oldStatus OrderStatus? @map("old_status")
  newStatus OrderStatus  @map("new_status")

  description String?
  createdBy   String? @map("created_by") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("order_status_history")
}

model LoyaltyProgram {
  id String @id @default(uuid())

  storeId String @map("store_id")
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name String @db.VarChar(120)

  purchasesRequired  Int     @default(10) @map("purchases_required")
  minimumOrderAmount Decimal @default(16.00) @map("minimum_order_amount") @db.Decimal(10, 2)
  validityMonths     Int     @default(10) @map("validity_months")

  rewardDescription String? @map("reward_description") @db.VarChar(255)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cards CustomerLoyaltyCard[]

  @@map("loyalty_programs")
}

model CustomerLoyaltyCard {
  id String @id @default(uuid())

  customerId       String @map("customer_id")
  loyaltyProgramId String @map("loyalty_program_id")

  cardNumber Int @map("card_number")

  status LoyaltyCardStatus @default(ACTIVE)

  currentStamps  Int @default(0) @map("current_stamps")
  requiredStamps Int @default(10) @map("required_stamps")

  startedAt DateTime @default(now()) @map("started_at")
  expiresAt DateTime @map("expires_at")

  completedAt DateTime? @map("completed_at")
  redeemedAt  DateTime? @map("redeemed_at")
  expiredAt   DateTime? @map("expired_at")

  rewardDescription String @map("reward_description") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loyaltyProgram LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id], onDelete: Cascade)

  transactions LoyaltyTransaction[]

  @@unique([customerId, cardNumber])
  @@index([customerId, status])
  @@map("customer_loyalty_cards")
}

model LoyaltyTransaction {
  id String @id @default(uuid())

  loyaltyCardId String              @map("loyalty_card_id")
  loyaltyCard   CustomerLoyaltyCard @relation(fields: [loyaltyCardId], references: [id], onDelete: Cascade)

  orderId String? @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  transactionType LoyaltyTransactionType @map("transaction_type")
  quantity        Int

  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([orderId, transactionType])
  @@index([loyaltyCardId])
  @@index([orderId])
  @@map("loyalty_transactions")
}

model NotificationLog {
  id String @id @default(uuid())

  orderId String? @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  channel   NotificationChannel
  recipient String?             @db.VarChar(120)
  message   String?

  status NotificationStatus @default(PENDING)

  sentAt       DateTime? @map("sent_at")
  errorMessage String?   @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("notification_logs")
}

model Banner {
  id String @id @default(uuid())

  imageUrl       String  @map("image_url")
  mobileImageUrl String? @map("mobile_image_url")
  tabletImageUrl String? @map("tablet_image_url")

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([sortOrder])
  @@map("banners")
}

enum PromotionType {
  BUY_X_GET_Y
  PERCENTAGE_DISCOUNT
  COUPON_PERCENTAGE_DISCOUNT
}

model Promotion {
  id String @id @default(uuid())

  name        String
  description String?
  type        PromotionType

  couponCode String? @unique @map("coupon_code") @db.VarChar(40)

  buyProductId String? @map("buy_product_id")
  buyQuantity  Int     @default(1) @map("buy_quantity")

  rewardProductId String? @map("reward_product_id")
  rewardQuantity  Int?    @map("reward_quantity")

  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)

  isActive Boolean @default(true) @map("is_active")

  startsAt DateTime? @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  buyProduct    Product? @relation("PromotionBuyProduct", fields: [buyProductId], references: [id], onDelete: SetNull)
  rewardProduct Product? @relation("PromotionRewardProduct", fields: [rewardProductId], references: [id], onDelete: SetNull)

  eligibleProducts PromotionEligibleProduct[]

  @@index([type])
  @@index([isActive])
  @@index([couponCode])
  @@index([buyProductId])
  @@index([rewardProductId])
  @@map("promotions")
}

model PromotionEligibleProduct {
  id String @id @default(uuid())

  promotionId String @map("promotion_id")
  productId   String @map("product_id")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([promotionId, productId])
  @@index([promotionId])
  @@index([productId])
  @@map("promotion_eligible_products")
}

// ─── Fidelidade v2 ────────────────────────────────────────────────────────────

enum LoyaltyStampHistoryType {
  ORDER_EARNED
  ADMIN_ADD
  ADMIN_REMOVE
  REWARD_GRANTED
  REWARD_REDEEMED
}

model LoyaltySettings {
  id                String   @id @default(uuid())
  isEnabled         Boolean  @default(true) @map("is_enabled")
  title             String   @default("Cartão Fidelidade")
  description       String?
  cardImageUrl      String?  @map("card_image_url")
  minOrderAmount    Decimal  @default(16.00) @map("min_order_amount") @db.Decimal(10, 2)
  stampsRequired    Int      @default(10) @map("stamps_required")
  validityMonths    Int      @default(10) @map("validity_months")
  rewardDescription String   @default("Ganhe 1 açaí grátis") @map("reward_description")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("loyalty_settings")
}

model CustomerLoyalty {
  id                String   @id @default(uuid())
  customerId        String   @unique @map("customer_id")
  stamps            Int      @default(0)
  availableRewards  Int      @default(0) @map("available_rewards")
  totalEarnedStamps Int      @default(0) @map("total_earned_stamps")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  customer Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  history  LoyaltyStampHistory[]

  @@map("customer_loyalties")
}

model LoyaltyStampHistory {
  id                String                  @id @default(uuid())
  customerLoyaltyId String                  @map("customer_loyalty_id")
  orderId           String?                 @map("order_id")
  type              LoyaltyStampHistoryType
  quantity          Int
  reason            String?
  createdAt         DateTime                @default(now()) @map("created_at")

  customerLoyalty CustomerLoyalty @relation(fields: [customerLoyaltyId], references: [id], onDelete: Cascade)
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerLoyaltyId])
  @@index([orderId])
  @@map("loyalty_stamp_histories")
}

// ─── Cartão Fidelidade por ciclo ──────────────────────────────────────────────

model LoyaltyCard {
  id                String            @id @default(uuid())
  customerId        String            @map("customer_id")
  status            LoyaltyCardStatus @default(ACTIVE)
  stamps            Int               @default(0)
  stampsRequired    Int               @default(10) @map("stamps_required")
  minOrderAmount    Decimal           @default(16.00) @map("min_order_amount") @db.Decimal(10, 2)
  rewardDescription String            @map("reward_description")
  startedAt         DateTime          @default(now()) @map("started_at")
  expiresAt         DateTime          @map("expires_at")
  completedAt       DateTime?         @map("completed_at")
  redeemedAt        DateTime?         @map("redeemed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
  @@map("loyalty_cards")
}

// ─── Informativo / Pop-up inicial ─────────────────────────────────────────────

model SiteAnnouncement {
  id        String   @id @default(uuid())
  imageUrl  String   @map("image_url")
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_announcements")
}

model PasswordRecoverySetting {
  id              String   @id @default(uuid())
  enabled         Boolean  @default(true)
  subjectTemplate String?  @map("subject_template") @db.VarChar(255)
  bodyTemplate    String?  @map("body_template") @db.Text
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("password_recovery_settings")
}

model PasswordRecoveryAttempt {
  id        String   @id @default(uuid())
  email     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("password_recovery_attempts")
}
